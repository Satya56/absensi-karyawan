NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
ATTENDANCE_TIMEZONE=Asia/Jakarta

# Replace this value with a long random secret before starting the API.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=28800

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=attendance
DB_PASSWORD=attendance
DB_DATABASE=attendance
DB_SYNC=true

PHOTO_STORAGE=local
PHOTO_LOCAL_DIRECTORY=uploads
# For AWS: PHOTO_STORAGE=s3, AWS_REGION=..., AWS_S3_BUCKET=...
# For GCP: PHOTO_STORAGE=gcs, GCP_BUCKET=...
AWS_REGION=
AWS_S3_BUCKET=
GCP_BUCKET=
MAX_PHOTO_SIZE_MB=8

# Required only when creating the first HR account with `npm run seed:hr`.
# Remove these values after the account has been created.
BOOTSTRAP_HR_NAME=
BOOTSTRAP_HR_EMAIL=
BOOTSTRAP_HR_PASSWORD=
BOOTSTRAP_HR_BIRTH_DATE=
BOOTSTRAP_HR_ADDRESS=
BOOTSTRAP_HR_LATITUDE=
BOOTSTRAP_HR_LONGITUDE=
